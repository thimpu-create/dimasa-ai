{
  "language": "Dimasa",
  "family": "Sino-Tibetan / Tibeto-Burman / Bodo-Garo",
  "word_order": "SOV (Subject - Object - Verb)",
  "features": {
    "gender": "Natural sex recognition; no grammatical gender inflection on verbs or adjectives.",
    "number": "Plural markers (-buthu / -si), but no grammatical subject-predicate number agreement.",
    "case_relations": "Expressed via postpositions.",
    "verb_roots": "Primarily monosyllabic.",
    "causative": "Formed by suffixing / adding 'ri' (give) to verb root.",
    "classifiers": {
      "human": "sao- (e.g., subung sao-si = one person)",
      "animals": "ma- (e.g., alu ma-si = one cat, misi ma-si = one tiger)",
      "long/cylindrical/tools": "gong- (e.g., repgong gong-si = one pen, bongphang gong-si = one tree)",
      "flat/thin": "la- / patha-",
      "round/fruit": "thai- (e.g., thaigao thai-si = one fruit)"
    },
    "case_markers": {
      "nominative": "unmarked or -ra",
      "accusative_objective": "-ke (e.g., angke = me, boke = him/her, ningke = you)",
      "genitive_possessive": "-ni (e.g., ani = my, nini = your, boni = his/her, jini = our)",
      "locative_dative": "-ha / -niha (e.g., noha = at home, in the house)"
    },
    "tense_aspect_markers": {
      "present_simple_continuous": "-du / -duhi (e.g., thangdu = going/goes, jadu = eating/eats)",
      "past_completed": "-ba (e.g., thangba = went, jaba = ate, nuba = saw)",
      "future_intention": "-nang / -ma (e.g., thangnang = will go, janang = will eat)",
      "imperative": "-bo / -ba (e.g., fabo = come!, thango = go!)",
      "negative": "da- prefix (imperative negative: dathang = don't go!) or -ya suffix (present/past negative: thangya = does not go)"
    }
  },
